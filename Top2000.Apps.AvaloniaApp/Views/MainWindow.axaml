<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Top2000.Apps.AvaloniaApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Top2000.Apps.AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding SelectedEdition.Year}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Button Command="{Binding LoadedAsync}" Content="Hello" DockPanel.Dock="Right" />
        <ListBox DockPanel.Dock="Left"
                 ItemsSource="{Binding Listings}">
            <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,5" RowSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Spacing="0">

                                       <!-- Style="{StaticResource MediumLabelStyle}"  -->
                                <TextBlock Text="{Binding PositionString}" 
                                           Margin="20,0,0,0" />

                                <Grid Margin="20,0,0,0">
                                    <TextBlock Margin="13,0,0,0" 
                                          
                                           FontSize="{Binding DeltaFontSize}"
                                           Text="{Binding Delta}"
                                           Foreground="{Binding DeltaSymbolColour}" />

                                    <!-- Style="{StaticResource SmallLabelStyle}"-->
                                    <TextBlock 
                                               FontSize="{Binding DeltaFontSize}"
                                               FontFamily="{StaticResource MaterialIcons}"
                                               Text="{Binding DeltaSymbol}"
                                               
                                               Foreground="{Binding DeltaSymbolColour}" />
                                </Grid>
                            </StackPanel>
                            <!--Style="{StaticResource MediumLabelStyle}"
                            Style="{StaticResource SmallLabelStyle}" -->
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Title}"    Margin="0,0,20,0" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Artist}"   Margin="0,0,20,0" Opacity=".5" />
                        </Grid>
                    </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
    
</Window>
